#!/bin/bash
# Phase H8 gap-closing grid on PACE ICE (CPU): one sweep variant per array task, every seed of
# that variant in the task (done seeds are skipped). Generic: pass the sweep and the array range.
# Submit from the repo root on a clean, committed tree (common.sh refuses a dirty one):
#   mkdir -p runs/slurm
#   sbatch --array=0-11 --export=ALL,SWEEP=configs/sweeps/gapA_wesad12_mlp.yaml,OUT_PREFIX=h8 scripts/slurm/gap.sbatch
#   sbatch --array=0-7  --export=ALL,SWEEP=configs/sweeps/gapC_wesad12_mlp.yaml,OUT_PREFIX=h8 scripts/slurm/gap.sbatch
# Stage B / evaluation sweeps are GENERATED by `fedastro select` into $OUT/generated/ (untracked,
# under runs/), e.g. SWEEP=runs/h8-<sha>/generated/gapB_gapA_wesad12_mlp_federated.yaml, --array=0-15.
# Selection reads validation scores only (PREREG.md section 5). About 1.5-4 min per run on CPU.
# A Ray start-up failure (exit 75, src/fedastro/fl/simguard.py) is retried up to 3 times in the
# same task (scripts/slurm/retry.sh); if every attempt fails, resubmit that index.
#SBATCH -J h8gap
#SBATCH -A bios
#SBATCH -q coc-ice
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 4
#SBATCH --mem=16G
#SBATCH -t 02:00:00
#SBATCH -o runs/slurm/%x-%A_%a.out
set -uo pipefail
: "${SWEEP:?set SWEEP=<sweep yaml> with --export}"
source scripts/slurm/common.sh
source scripts/slurm/retry.sh
retry_tempfail uv run --frozen fedastro grid "$SWEEP" --index "$SLURM_ARRAY_TASK_ID" --resume --output-dir "$OUT"
